rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /evifinPlans/{uid} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function validSnapshot() {
        let data = request.resource.data;
        return data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
          && data.keys().hasAll(['payload', 'revision', 'updatedAt'])
          && data.payload is string
          && data.payload.size() > 0
          && data.payload.size() <= 900000
          && data.revision is int
          && data.updatedAt == request.time;
      }
      allow get: if isOwner();
      allow create: if isOwner() && validSnapshot()
        && request.resource.data.revision == 1;
      allow update: if isOwner() && validSnapshot()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
